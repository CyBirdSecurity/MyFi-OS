# Copy to .env and fill in values. Never commit .env to version control.

# ── Required ────────────────────────────────────────────────────────────────
# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=

# Used when running the Go server outside Docker (make dev-api). The app
# container builds its own connection string from POSTGRES_PASSWORD.
DATABASE_URL=postgres://myfi:${POSTGRES_PASSWORD}@localhost:5432/myfi?sslmode=disable
PORT=8080
ENV=development

# ── Optional ────────────────────────────────────────────────────────────────
# Transaction categorization model: "ollama" (default, runs locally) or
# "anthropic" (sends merchant names to Anthropic's API).
LLM_PROVIDER=ollama
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# Plaid bank sync. MyFi works without it. Set all three to turn it on, or
# leave all blank. Get the client ID and production secret at
# https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# Encrypts Plaid access tokens at rest. Generate with: openssl rand -hex 32
MYFI_ENCRYPTION_KEY=
